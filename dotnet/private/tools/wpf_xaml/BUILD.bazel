load(
    "//dotnet/private/rules/csharp:binary.bzl",
    "bootstrap_tool_binary",
)

# Runs the SDK's own WPF XAML compilation tasks (`MarkupCompilePass1` and
# `ResourcesGenerator`). See Program.cs.
bootstrap_tool_binary(
    name = "wpf_xaml",
    srcs = [
        "Program.cs",
        "//dotnet/private/tools/msbuild:srcs",
    ],
    include_msbuild_dlls = True,
    nullable = "enable",
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)
